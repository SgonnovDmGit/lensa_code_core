<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:LenSa.Core.Helpers">
    <!-- Preserve the original native container and text rules for Universal. -->
    <Style x:Key="ModelPickerNativeItemStyle" TargetType="ListBoxItem">
        <Style.Resources><helpers:ModelFitsContextConverter x:Key="FitsContext"/></Style.Resources>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Style.Triggers>
            <DataTrigger Value="False">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource FitsContext}">
                        <Binding Path="ContextLength"/>
                        <Binding Path="DataContext.ActiveChat.ContextTokens"
                                 RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="IsEnabled" Value="False"/>
                <Setter Property="Opacity" Value="0.45"/>
                <Setter Property="ToolTip" Value="{DynamicResource str_ModelTooSmall}"/>
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ModelPickerItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource ModelPickerNativeItemStyle}"/>
    <Style x:Key="ModelPickerNameStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True"/>
                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(Selector.IsSelectionActive)}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ModelPickerMetaStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
    </Style>
</ResourceDictionary>
