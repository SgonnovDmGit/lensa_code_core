<UserControl x:Class="LenSa.Core.Chat.Views.MetricChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Unloaded="Chip_Unloaded">
    <UserControl.Resources>
        <Style x:Key="InfoButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource SecondaryBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource SecondaryForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="FooterModel" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryForeground}"/>
        <TextBlock x:Name="FooterTime" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryForeground}"/>
        <Button x:Name="InfoButton" Style="{StaticResource InfoButtonStyle}"
                Click="InfoButton_Click" PreviewMouseDown="InfoButton_PreviewMouseDown"
                PreviewMouseUp="InfoButton_PreviewMouseUp"
                PreviewKeyDown="InfoButton_PreviewKeyDown"
                AutomationProperties.Name="{DynamicResource str_MetricClickHint}"
                ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
            <TextBlock Text="i" FontFamily="Georgia" FontStyle="Italic" FontWeight="SemiBold" FontSize="12"/>
        </Button>
        <Popup x:Name="CardPopup" PlacementTarget="{Binding ElementName=InfoButton}"
               Placement="Custom" StaysOpen="False" AllowsTransparency="True"
               Closed="CardPopup_Closed">
            <ScrollViewer x:Name="CardScroll" MaxHeight="540" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="True"
                          PreviewKeyDown="CardScroll_PreviewKeyDown"/>
        </Popup>
    </StackPanel>
</UserControl>
